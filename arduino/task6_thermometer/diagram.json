      "attrs": { "temperature": "24" }
    },
    {
      "type": "wokwi-led",
      "id": "ledBlue",
      "top": 0,
      "left": -160,
      "attrs": { "color": "blue" }
    },
    {
      "type": "wokwi-led",
      "id": "ledGreen",
      "top": 60,
      "left": -160,
      "attrs": { "color": "green" }
    },
    {
      "type": "wokwi-led",
      "id": "ledYellow",
      "top": 120,
      "left": -160,
      "attrs": { "color": "yellow" }
    },
    {
      "type": "wokwi-led",
      "id": "ledRed",
      "top": 180,
      "left": -160,
      "attrs": { "color": "red" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 0,
      "left": -80,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": 60,
      "left": -80,
      "attrs": { "value": "220" }
    },
    {
