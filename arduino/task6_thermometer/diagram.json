  "connections": [
    ["ntc:VCC", "nano:5V",    "red",   ["v0"]],
    ["ntc:GND", "nano:GND.1", "black", ["v0"]],
    ["ntc:OUT", "nano:A0",    "orange",["v0"]],

    ["nano:5",    "r1:1",         "blue",   ["v0"]],
    ["r1:2",      "ledBlue:A",    "blue",   ["v0"]],
    ["ledBlue:C", "nano:GND.2",   "black",  ["v0"]],

    ["nano:6",    "r2:1",         "green",  ["v0"]],
    ["r2:2",      "ledGreen:A",   "green",  ["v0"]],
    ["ledGreen:C","nano:GND.3",   "black",  ["v0"]],

    ["nano:7",    "r3:1",         "yellow", ["v0"]],
    ["r3:2",      "ledYellow:A",  "yellow", ["v0"]],
    ["ledYellow:C","nano:GND.4",  "black",  ["v0"]],

    ["nano:8",    "r4:1",         "red",    ["v0"]],
    ["r4:2",      "ledRed:A",     "red",    ["v0"]],
    ["ledRed:C",  "nano:GND.5",   "black",  ["v0"]],
  ]
